name: docker-compose-backend

on:
  push:
    branches:
      - main
    paths:
      - "backend/*"
  

jobs:
  
  updata-backend:
    runs-on: rocky
    defaults:
      run:
        working-directory: /home/badawy/bank-system-containerized-v2/devops-bank-system

    steps:
      - name: Build new backend
        run: docker compose build backend

      - name: Run new backend
        run: docker compose up -d --no-deps backend

